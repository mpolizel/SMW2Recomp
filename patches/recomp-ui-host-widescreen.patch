+/* The host-owned Widescreen row (GameInfo.host_widescreen_*), drawn by
+ * both DISPLAY surfaces right under the aspect row. */
+static void draw_host_widescreen_row(LauncherModel* m, const LauncherTheme& th) {
+    const float cb = ImGui::GetFrameHeight();   // a checkbox is square
+    if (!m->host_widescreen_get) return;
+    {
+        /* Host-owned: read on every draw, written back on change. The
+         * EXPERIMENTAL tag follows the checkbox, so it is part of the
+         * width the row reserves (as in draw_aspect_row). */
+        float ctrl_w = cb;
+        if (m->host_widescreen_experimental)
+            ctrl_w += px(8) + ImGui::CalcTextSize("EXPERIMENTAL").x;
+        row_label_right("Widescreen", th, ctrl_w);
+        bool ws = m->host_widescreen_get() != 0;
+        if (ImGui::Checkbox("##host_widescreen", &ws) && m->host_widescreen_set)
+            m->host_widescreen_set(ws ? 1 : 0);
+        const bool hovered = ImGui::IsItemHovered(ImGuiHoveredFlags_DelayNormal);
+        if (m->host_widescreen_experimental) {
+            ImGui::SameLine(0, px(8));
+            ImGui::AlignTextToFramePadding();
+            ImGui::TextColored(col(th.warn), "EXPERIMENTAL");
+        }
+        if ((hovered || ImGui::IsItemHovered(ImGuiHoveredFlags_DelayNormal)) &&
+            m->host_widescreen_help && m->host_widescreen_help[0])
+            ImGui::SetTooltip("%s", m->host_widescreen_help);
+    }
+}
