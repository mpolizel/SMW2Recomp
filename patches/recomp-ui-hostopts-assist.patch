+/* GameInfo.host_options: one row per option, label left, control right.
+ * The host owns every value (read on each draw, written back on change). */
+static void draw_host_options(LauncherModel* m, const LauncherTheme& th) {
+    const float cb = ImGui::GetFrameHeight();
+    float list_w = px(SETTINGS_CTRL_W);
+    for (int i = 0; i < m->host_option_count; ++i) {
+        const RecompLauncherCHostOption& o = m->host_options[i];
+        for (int c = 0; c < o.num_choices; ++c)
+            if (o.choices && o.choices[c]) {
+                const float w = ImGui::CalcTextSize(o.choices[c]).x +
+                                ImGui::GetFrameHeight() + px(24);
+                if (w > list_w) list_w = w;
+            }
+    }
+    for (int i = 0; i < m->host_option_count; ++i) {
+        const RecompLauncherCHostOption& o = m->host_options[i];
+        if (!o.label) continue;
+        ImGui::PushID(i);
+        const int value = m->host_option_get(i);
+        if (o.num_choices > 0 && o.choices) {
+            row_label_right(o.label, th, list_w);
+            const int cur = value >= 0 && value < o.num_choices ? value : 0;
+            ImGui::SetNextItemWidth(list_w);
+            if (ImGui::BeginCombo("##host_option", o.choices[cur])) {
+                for (int c = 0; c < o.num_choices; ++c) {
+                    if (!o.choices[c]) continue;
+                    if (ImGui::Selectable(o.choices[c], c == cur) &&
+                        m->host_option_set && c != cur)
+                        m->host_option_set(i, c);
+                }
+                ImGui::EndCombo();
+            }
+        } else {
+            row_label_right(o.label, th, cb);
+            bool on = value != 0;
+            if (ImGui::Checkbox("##host_option", &on) && m->host_option_set)
+                m->host_option_set(i, on ? 1 : 0);
+        }
+        if (o.help && o.help[0] &&
+            ImGui::IsItemHovered(ImGuiHoveredFlags_DelayNormal))
+            ImGui::SetTooltip("%s", o.help);
+        ImGui::PopID();
+    }
+}
