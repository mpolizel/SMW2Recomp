+void PpuSetWidescreenOptMarginV(Ppu *ppu, int first_col, const uint16_t *v,
+                                unsigned count) {
+  if (!ppu) return;
+  if (!v || count == 0) { ppu->wsOptMarginCount = 0; return; }
+  if (count > 128) count = 128;
+  ppu->wsOptMarginFirst = (int16_t)first_col;
+  ppu->wsOptMarginCount = (uint16_t)count;
+  memcpy(ppu->wsOptMarginV, v, count * sizeof(uint16_t));
